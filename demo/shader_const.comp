#version 450
// shader_const.comp — diagnostic kernel: every invocation writes a constant.
// Used when DEMO_SHADER=const to test the raw write path independently of
// any math (isolates turnip SSBO-write behaviour from arithmetic issues).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Data { float v[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 256u) return;
    v[i] = 42.0;
}
